#!/bin/sh
# The gate guard does NOT live here. See githooks/commit-msg.
#
# It used to, and that was the defect (housekeeping-03): `git merge` does not
# run pre-commit, so the guard never fired on the one operation it existed to
# guard. Keeping a copy here would double-consume the one-shot .gate-ok on the
# conflicted-merge route, where pre-commit and commit-msg both run -- the first
# would eat the stamp and the second would then refuse a legitimate merge.
# Deliberately empty. If you add a pre-commit check, do not put the gate guard
# in it.
exit 0
