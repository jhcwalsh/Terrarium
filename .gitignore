# The licensed vintage store at the repository root (never committed — see CLAUDE.md /
# STEP1 licensing discipline). ANCHORED with a leading slash: the unanchored `data/`
# this line used to read matched ANY directory named `data` at any depth, which silently
# excluded the entire `src/ah/data/` package (all of Step 1's data layer), every
# synthetic connector fixture under `tests/fixtures/data/`, and `docs/data/`. Those are
# source, tests and documentation, not licensed data, and they must be committed.
/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Environments
.venv/
venv/
env/

# uv
# (uv.lock IS committed; the venv is not)

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets — never commit
.env
.env.*

